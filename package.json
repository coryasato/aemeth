{
  "name": "aemeth",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsgo tsc -b",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "knip": "knip",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run knip"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.2.0",
    "@effect/tsgo": "0.73.4",
    "@effect/vitest": "4.1.5",
    "effect": "4.1.5",
    "knip": "6.48.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
