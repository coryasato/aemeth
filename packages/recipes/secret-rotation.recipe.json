{
  "$schema": "./recipe.schema.json",
  "format": 1,
  "id": "secret-rotation",
  "version": 1,
  "title": "Secret rotation",
  "description": "Replaces a credential everywhere it is used, and revokes the old one only after every consumer works with the new one.",
  "start": "create",
  "inputs": {
    "issuer": {
      "type": {
        "_tag": "Resource",
        "kind": "secrets.issuer"
      }
    },
    "current": {
      "type": {
        "_tag": "Resource",
        "kind": "secrets.credential"
      }
    },
    "consumers": {
      "type": {
        "_tag": "List",
        "item": {
          "_tag": "Resource",
          "kind": "secrets.consumer"
        }
      }
    }
  },
  "nodes": [
    {
      "_tag": "Step",
      "id": "create",
      "block": "secrets.createCredential",
      "version": 1,
      "inputs": {
        "issuer": {
          "_tag": "RecipeInput",
          "name": "issuer"
        }
      }
    },
    {
      "_tag": "Step",
      "id": "deploy",
      "block": "secrets.deployCredential",
      "version": 1,
      "inputs": {
        "consumer": {
          "_tag": "ForEachItem"
        },
        "credential": {
          "_tag": "StepOutput",
          "step": "create",
          "output": "credential"
        },
        "previous": {
          "_tag": "RecipeInput",
          "name": "current"
        }
      },
      "forEach": {
        "over": {
          "_tag": "RecipeInput",
          "name": "consumers"
        },
        "onItemFailure": "Continue"
      }
    },
    {
      "_tag": "Step",
      "id": "check",
      "block": "secrets.checkConsumer",
      "version": 1,
      "inputs": {
        "consumer": {
          "_tag": "ForEachItem"
        },
        "credential": {
          "_tag": "StepOutput",
          "step": "create",
          "output": "credential"
        }
      },
      "forEach": {
        "over": {
          "_tag": "RecipeInput",
          "name": "consumers"
        },
        "onItemFailure": "Continue"
      }
    },
    {
      "_tag": "Step",
      "id": "approve",
      "block": "gate.approveRevocation",
      "version": 1,
      "inputs": {
        "credential": {
          "_tag": "RecipeInput",
          "name": "current"
        }
      }
    },
    {
      "_tag": "Step",
      "id": "revoke",
      "block": "secrets.revokeCredential",
      "version": 1,
      "inputs": {
        "credential": {
          "_tag": "RecipeInput",
          "name": "current"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "create",
      "on": "Succeeded",
      "to": {
        "_tag": "Step",
        "id": "deploy"
      }
    },
    {
      "from": "deploy",
      "on": "Succeeded",
      "to": {
        "_tag": "Step",
        "id": "check"
      }
    },
    {
      "from": "check",
      "on": "Succeeded",
      "to": {
        "_tag": "Step",
        "id": "approve"
      }
    },
    {
      "from": "approve",
      "on": "Approved",
      "to": {
        "_tag": "Step",
        "id": "revoke"
      }
    },
    {
      "from": "revoke",
      "on": "Failed",
      "to": {
        "_tag": "End",
        "result": "Failed",
        "undo": "Skip"
      }
    }
  ],
  "finally": [],
  "invariants": [
    {
      "rule": "OnlyAfter",
      "step": "revoke",
      "requires": ["deploy", "check"]
    }
  ]
}
