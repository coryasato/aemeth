{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          {
            "include": ["**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "floatingEffect": "error"
              }
            }
          },
          {
            "include": ["**/*.test.ts"],
            "options": {
              "allowedUnstableApis": ["@effect/vitest"]
            }
          },
          {
            "include": ["infra/**/*.ts"],
            "options": {
              "allowedUnstableApis": ["effect/http", "@effect/vitest"]
            }
          },
          {
            "include": ["apps/engine/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "floatingEffect": "error"
              },
              "allowedExperimentalApis": ["@effect/platform-cloudflare"],
              "allowedUnstableApis": [
                "effect/workflow",
                "effect/cluster",
                "effect/rpc",
                "effect/http",
                "effect/sql",
                "effect/reactivity",
                "@effect/sql-sqlite-node",
                "@effect/vitest"
              ]
            }
          }
        ]
      }
    ]
  }
}
